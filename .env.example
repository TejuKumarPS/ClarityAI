# ==============================================================================
# ClarityAI Configuration Template (.env.example)
# Copy this file to .env:
#   cp .env.example .env
# ==============================================================================

# Application
PROJECT_NAME="ClarityAI"
ENVIRONMENT="development"
API_V1_STR="/api/v1"
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Security & Authentication
# IMPORTANT: Generate a strong, random 32+ character key for production
JWT_SECRET_KEY="dev_insecure_jwt_secret_key_clarityai_development_only_2026"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Configuration (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=clarityai_dev
# Local development outside Docker:
# DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/clarityai_dev"
# Docker Compose environment:
# DATABASE_URL="postgresql+psycopg://postgres:postgres@postgres:5432/clarityai_dev"

# Celery & Redis Broker
# Local development outside Docker:
# REDIS_URL="redis://localhost:6379/0"
# Docker Compose environment:
# REDIS_URL="redis://redis:6379/0"
CELERY_TASK_MAX_RETRIES=3
CELERY_TASK_RETRY_BACKOFF=1

# LLM & AI Pipeline Configuration
LLM_ENABLED=true
# LLM Provider Selection: "groq" or "openai"
# If GROQ_API_KEY is provided and OPENAI_API_KEY is empty, Groq is automatically selected.
LLM_PROVIDER="groq"

# Groq Configuration (Recommended)
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"
GROQ_BASE_URL="https://api.groq.com/openai/v1"

# OpenAI Configuration (Alternative)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Pipeline & Context Settings
MAX_LLM_INPUT_CHARACTERS=100000
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_MAX_RETRY_ATTEMPTS=3

# Chunking & Retrieval Settings
CHUNK_SIZE_CHARS=4000
CHUNK_OVERLAP_CHARS=400
MAX_RETRIEVAL_CONTEXT_CHARACTERS=20000
DEFAULT_MAX_RETRIEVAL_RESULTS=5
MAX_RETRIEVAL_QUERY_CHARS=100

# Rate Limiting (per user per hour)
RATE_LIMIT_JOBS_PER_HOUR=20
