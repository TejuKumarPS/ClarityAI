# ==============================================================================
# ClarityAI Backend Configuration
# ==============================================================================

# Application
PROJECT_NAME="ClarityAI"
ENVIRONMENT="development"
API_V1_STR="/api/v1"
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Database Configuration
# Local development:
DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/clarityai_dev"
# Docker Compose environment:
# DATABASE_URL="postgresql+psycopg://postgres:postgres@postgres:5432/clarityai_dev"

# Security & Authentication
JWT_SECRET_KEY="your-jwt-secret-key-min-32-chars"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Celery & Redis Broker
# Local development:
REDIS_URL="redis://localhost:6379/0"
# Docker Compose environment:
# REDIS_URL="redis://redis:6379/0"
CELERY_TASK_MAX_RETRIES=3
CELERY_TASK_RETRY_BACKOFF=1

# LLM & AI Pipeline Configuration
LLM_ENABLED=true
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
MAX_LLM_INPUT_CHARACTERS=100000
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_MAX_RETRY_ATTEMPTS=3

# Chunking & Retrieval
CHUNK_SIZE_CHARS=4000
CHUNK_OVERLAP_CHARS=400
MAX_RETRIEVAL_CONTEXT_CHARACTERS=20000
DEFAULT_MAX_RETRIEVAL_RESULTS=5
MAX_RETRIEVAL_QUERY_CHARS=100

# Rate Limiting
RATE_LIMIT_JOBS_PER_HOUR=20
