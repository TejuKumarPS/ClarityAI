# ==============================================================================
# ClarityAI Frontend Configuration
# ==============================================================================

# API Base URL (defaults to relative /api/v1 for Vite proxying)
# For direct backend access in local standalone mode:
VITE_API_BASE_URL=http://localhost:8000/api/v1

# For Docker Compose development with reverse proxying, leave as /api/v1
# VITE_API_BASE_URL=/api/v1
